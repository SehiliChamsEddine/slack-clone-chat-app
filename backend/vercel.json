{
	"version": 2,
	"builds": [
		{
			"src": "dist/server.js",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "dist/server.js",
			"methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
			"headers": {
				"Access-Control-Allow-Origin": "http://localhost:5173"
			}
		}
	],
	"env": {
		"NODE_ENV": "production"
	}
}
